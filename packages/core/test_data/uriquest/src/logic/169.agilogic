if (said("examine") || said("examine", "a") || said("examine", "room")) {
  print("You're near Edwards Auditorium.");
}

if (said("examine", "building") || said("examine", "ed")) {
  print("It's a big, old stone building.");
}

if (said("examine", "d") || said("o", "d")) {
  print("You don't want to go in there, forget it.");
}

if (said("examine", "floor")) {
  print("You see nothing important.");
}

if (said("examine", "window")) {
  print("There's nothing interesting to see in there.");
}

if (said("examine", "sidewalk")) {
  print("They're sidewalks, lonely sidewalks.");
}

if (said("examine", "bulletin board")) {
  print("The messages are all unimportant.");
}

if (said("examine", "bush")) {
  print("The bushes serve no purpose.");
}

if (said("examine", "road")) {
  print("It's flat, dark and hard.");
}

if (said("chat")) {
  print("You should stop talking to yourself.");
}

