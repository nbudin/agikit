if (said("chat", "neal")) {
  if (posn(o0, 75, 108, 100, 114)) {
    if (!f165) {
      if (f162) {
        print("\"Hey Jeff, what's up?\" asks Neal.");
        print("\"Not much, Tater. Not much.  Hey! actually...\" you start.");
        print("\"I was in Tyler 109 today and I met the infamous EVK102!\" you continue.");
        print("\"REALLY?\" asks Neal incredulously.");
        print("\"Yep!  He mentioned that there's this new game coming out called Wolfenstein. It's supposed to be really cool.  I don't know how it can possibly be better than Space Quest 4, but I'm willing to give it a try.\" you say.");
        print("\"Yeah, sounds cool.\" replies Tater.");
        print("\"But since I'm going to be pretty busy over the next couple of days, do you think you can download it for us?  Then we can meet for dinner at Rojo's on Saturday and try it out on my computer afterwards.\" you say.");
        print("\"Sounds good to me!\" replies Neal. \"I'll download it tomorrow and meet you at Rojo's for dinner on Saturday.\"");
        set(f165);
        v3 += 1;
        load.sound(1);
        sound(1, f153);
        print("\"Cool, thanks! See you later!\" you say.");
      } else {
        print("\"Nice weather we're having.\" says Neal.");
        print("\"Yep.\" you reply.");
      }
    } else {
      print("\"I'll meet you for dinner in a couple of days, then.\", says Tater.");
    }
  } else {
    print("Try getting closer.");
  }
}

