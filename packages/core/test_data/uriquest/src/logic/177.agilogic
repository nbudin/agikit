if (said("examine") || said("examine", "a") || said("examine", "room")) {
  print("You're in the eastern part of campus on Upper College Road.");
}

if (said("examine", "planetarium") || said("examine", "building")) {
  print("You see the small URI planetarium here. You wonder if anyone has ever actually been in it.");
}

if (said("examine", "floor")) {
  print("You see nothing important.");
}

if (said("examine", "sidewalk")) {
  print("It's just a sidewalk.");
}

if (said("examine", "road")) {
  print("Upper College Road runs along the top part of campus.");
}

if (said("cross", "road")) {
  print("Just try it... I dare ya.");
}

if (said("examine", "tree")) {
  print("The trees around this area always smell like rancid shit. You try to avoid coming through here as much as possible.");
}

if (said("smell", "tree")) {
  print("EEEEWWWWW!!!!!");
}

if (said("examine", "bush")) {
  print("There's nothing special about the bushes. Well, maybe George.");
}

if (said("chat")) {
  print("You should stop talking to yourself.");
}

if (f3) {
  program.control();
  ignore.objs(o0);
  ignore.objs(o1);
  move.obj(o0, 95, 100, 1, f100);
}

if (f100) {
  set.loop(o0, 1);
  set.cel(o0, 0);
  load.sound(18);
  sound(18, f153);
  draw(o1);
  move.obj(o1, 45, 100, 1, f101);
  reset(f100);
}

if (f101) {
  erase(o0);
  draw(o2);
  move.obj(o1, 150, 100, 1, f102);
  reset(f101);
}

if (f102) {
  reset(f102);
  erase(o1);
  v35 = 3;
}

