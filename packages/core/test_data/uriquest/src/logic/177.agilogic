if (f5) {
  load.pic(v0);
  draw.pic(v0);
  discard.pic(v0);
  set.horizon(0);

  if (v1 == 165) {
    position(o0, 80, 165);
  }
  reset(f100);
  reset(f101);
  reset(f102);
  animate.obj(o1);
  load.view(48);
  set.view(o1, 48);
  set.loop(o1, 0);
  set.cel(o1, 0);
