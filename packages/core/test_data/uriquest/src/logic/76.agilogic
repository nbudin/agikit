if (f5) {
  load.pic(v0);
  draw.pic(v0);
  discard.pic(v0);
  set.horizon(40);

  if (v1 == 88) {
    position(o0, 80, 45);
  }
  draw(o0);
  show.pic();
}

if (said("examine") || said("examine", "a") || said("examine", "room")) {
  print("You're on a street going up campus.");
}

if (said("examine", "fence")) {
  print("Yup, it's a fence.");
}

if (said("examine", "floor")) {
  print("You see nothing important.");
}

if (said("examine", "road")) {
  print("You see nothing interesting about it.");
}

if (said("examine", "sidewalk")) {
  print("There's nothing interesting about it.");
}

if (said("examine", "tree")) {
  print("There's nothing important about the tree.");
}

if (said("chat")) {
  print("You should stop talking to yourself.");
}

