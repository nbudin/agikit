if (said("examine") || said("examine", "a") || said("examine", "room")) {
  print("You're just outside of the Union.");
}

if (said("examine", "memorial union") || said("examine", "building")) {
  print("It, along with the rest of campus, is curiously empty today.");
}

if (said("examine", "floor")) {
  print("You see ugly, dirty cement.");
}

if (said("examine", "cement")) {
  print("There's nothing special about it.");
}

if (said("examine", "bulletin board")) {
  print("You look through the postings, but see nothing of interest.");
}

if (said("examine", "wall")) {
  print("Yes, they're pretty ugly. There's a bulletin board on the left wall.");
}

if (said("o", "memorial union", "d") || said("o", "memorial union") || said("o", "d") || said("o", "building", "d")) {
  if (posn(o0, 80, 117, 98, 127)) {
    program.control();
    load.sound(3);
    sound(3, f153);
    end.of.loop(o1, f101);
  } else {
