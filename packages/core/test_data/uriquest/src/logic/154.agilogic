if (said("examine") || said("examine", "a") || said("examine", "room")) {
  print("You're in the middle of the quad.");
}

if (said("examine", "east") || said("examine", "building")) {
  print("In the distance, you see East Hall.");
}

if (said("examine", "floor")) {
  print("You see nothing important.");
}

if (said("examine", "quad")) {
  print("It's a nice grassy area. There is a flag pole here.");
}

if (said("examine", "flagpole") || said("examine", "flag", "flagpole")) {
  print("It has a flag on it. And no, you can't climb it.");
}

if (said("climb", "flagpole") || said("climb", "flag", "flagpole")) {
  print("NO!!!!");
}

if (said("examine", "sidewalk")) {
  print("It leads to the top of the quad.");
}

if (said("examine", "path")) {
  print("It leads to the top of the quad.");
}

if (said("examine", "tree")) {
  print("It's amazing! There are trees here.");
}

if (said("examine", "bush")) {
  print("There's nothing special about the bushes.");
}

if (said("chat")) {
  print("You should stop talking to yourself.");
}

