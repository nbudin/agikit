  draw(o0);
  show.pic();
}

if (said("examine") || said("examine", "a") || said("examine", "room")) {
  print("You're in front of Ranger Hall.");
}

if (said("examine", "ranger") || said("examine", "building")) {
  print("It looks just like most of the old stone buildings on campus.");
}

if (said("examine", "d") || said("o", "d")) {
  print("You have no need or desire to go in there.");
}

if (said("examine", "floor")) {
  print("You see nothing important.");
}

if (said("examine", "sidewalk")) {
  print("It leads to the building.");
}

if (said("examine", "path")) {
  print("It leads to the building.");
}

if (said("examine", "bush")) {
  print("There's nothing special about the bushes.");
}

if (said("examine", "road")) {
  print("It leads to the top of campus.");
}

if (said("examine", "window")) {
  print("You see nothing in there.");
}

if (said("chat")) {
  print("You should stop talking to yourself.");
}

