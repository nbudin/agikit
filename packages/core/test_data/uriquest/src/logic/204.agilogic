if (f5) {
  load.pic(v0);
  draw.pic(v0);
  discard.pic(v0);
  set.horizon(0);

  if (v1 == 203) {
    position(o0, 40, 120);
    v6 = 7;
  }

  if (v1 == 205) {
    position(o0, 110, 120);
    v6 = 7;
  }
  draw(o0);
  show.pic();
}

if (said("examine") || said("examine", "a") || said("examine", "room") || said("examine", "stair well")) {
  print("This is the stairwell on the fourth floor of Bressler Hall.");
}

if (said("examine", "stairs")) {
  print("They're concrete, dirty, and ugly.");
}

if (said("examine", "d")) {
  print("It leads to the hallway on this floor.");
}

if (said("o", "d")) {
  print("It's already open!");
}

if (said("examine", "window") || said("examine", "outside")) {
  print("You can see outside.");
}

if (said("examine", "rail")) {
  print("Unlike the other floors, there is a railing here. Either I was lazy drawing those rooms, or there really aren't railings in the dorm. You make the call!");
}

if (said("examine", "wall") || said("examine", "floor") || said("examine", "ceiling")) {
  print("They're pretty much the same as the rest of the dismal dorm.");
}

if (said("chat")) {
  print("You should stop talking to yourself.");
}

if ((f3) && (posn(o0, 1, 60, 60, 150))) {
  new.room(203);
}

if ((f3) && (posn(o0, 61, 60, 159, 150))) {
  new.room(205);
}
return();


