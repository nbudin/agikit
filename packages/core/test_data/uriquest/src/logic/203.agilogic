if (said("examine") || said("examine", "a") || said("examine", "room") || said("examine", "stair well")) {
  print("This is the stairwell on the third floor of Bressler Hall.");
}

if (said("examine", "stairs")) {
  print("They're concrete, dirty, and ugly.");
}

if (said("examine", "d")) {
  print("It leads to the hallway on this floor.");
}

if (said("o", "d")) {
  print("It's already open!");
}

if (said("examine", "window") || said("examine", "outside")) {
  print("You can see outside.");
}

if (said("examine", "rail")) {
  print("There isn't one! Either I was lazy drawing this room, or there really isn't one in the dorm. You make the call!");
}

if (said("examine", "wall") || said("examine", "floor") || said("examine", "ceiling")) {
  print("They're pretty much the same as the rest of the dismal dorm.");
}

