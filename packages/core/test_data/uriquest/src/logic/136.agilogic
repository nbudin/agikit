if (f5) {
  load.pic(v0);
  draw.pic(v0);
  discard.pic(v0);
  set.horizon(49);

  if (v1 == 150) {
    position(o0, 40, 55);
  }

  if (v1 == 124) {
    position(o0, 75, 165);
  }
  draw(o0);
  show.pic();
}

if (said("examine") || said("examine", "a") || said("examine", "room")) {
  print("You're in the northeastern part of campus.");
}

if (said("examine", "building")) {
  print("There are some buildings in the distance.");
}

if (said("examine", "floor")) {
  print("You see nothing important.");
}

if (said("examine", "window")) {
  print("There's nothing interesting to see in there.");
}

if (said("examine", "bush")) {
  print("Na' ga' do it!.");
}

if (said("examine", "lot")) {
  print("You see a staff parking lot.");
}

if (said("examine", "tree")) {
  print("Yup, there's a tree here.");
}

if (said("examine", "road")) {
  print("This street continues on to the quad.");
}

if (said("examine", "boulder")) {
  print("You see a big rock. Yup, it's just a big rock.");
}

if (said("chat")) {
  print("You should stop talking to yourself.");
}

if (v2 == 1) {
  new.room(150);
}

if (v2 == 4) {
  new.room(135);
}

if (v2 == 2) {
  new.room(137);
}

if (v2 == 3) {
  new.room(124);
}
